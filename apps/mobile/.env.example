# =============================================================================
# apps/mobile/.env.example — Mobile App Client Environment Variables
# =============================================================================
#
# Variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle by Expo.
# Do NOT put secrets here — anything with EXPO_PUBLIC_ is exposed in the app.
#
# USAGE:
#   cp apps/mobile/.env.example apps/mobile/.env.local
#
# Backend/secret variables (Clerk secret, Stripe secret, Resend, etc.)
# are in the root .env.example.
#
# NOTE: Expo reads .env.local automatically when running `expo start`.
# For EAS builds, configure secrets in the EAS dashboard or eas.json.
# =============================================================================


# -----------------------------------------------------------------------------
# CONVEX
# The HTTP URL for the Convex backend this mobile app connects to.
# Find in the Convex dashboard under your deployment's settings.
# Example: "https://happy-animal-123.convex.cloud"
# -----------------------------------------------------------------------------
EXPO_PUBLIC_CONVEX_URL=https://


# -----------------------------------------------------------------------------
# CLERK
# Publishable key for client-side Clerk authentication in the mobile app.
# Safe to expose — this is a public key.
# Find in the Clerk dashboard under API Keys.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
