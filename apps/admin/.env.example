# =============================================================================
# apps/admin/.env.example — Admin App Client Environment Variables
# =============================================================================
#
# Variables prefixed with VITE_ are bundled into the client by Vite.
# Do NOT put secrets here — anything with VITE_ is exposed in the browser.
#
# USAGE:
#   cp apps/admin/.env.example apps/admin/.env.local
#
# Backend/secret variables (Clerk secret, Stripe secret, Resend, etc.)
# are in the root .env.example.
# =============================================================================


# -----------------------------------------------------------------------------
# CONVEX
# The HTTP URL for the Convex backend this admin app connects to.
# Find in the Convex dashboard under your deployment's settings.
# Example: "https://happy-animal-123.convex.cloud"
# -----------------------------------------------------------------------------
VITE_CONVEX_URL=https://


# -----------------------------------------------------------------------------
# CLERK
# Publishable key for client-side Clerk authentication.
# Safe to expose — this is a public key.
# Find in the Clerk dashboard under API Keys.
# -----------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_


# -----------------------------------------------------------------------------
# STRIPE
# Publishable key for client-side Stripe usage (e.g., Stripe.js, Elements).
# Safe to expose — this is a public key.
# Find in the Stripe dashboard under Developers > API keys.
# -----------------------------------------------------------------------------
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_
