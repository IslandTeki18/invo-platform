# =============================================================================
# ROOT .env.example — Shared / Backend Environment Variables
# =============================================================================
#
# These are server-side or shared variables not tied to a single app.
# Per-app client-exposed variables live in apps/<app>/.env.example.
#
# USAGE:
#   Copy this file to .env.local and fill in real values.
#   .env.local is gitignored — never commit real secrets.
#
#   cp .env.example .env.local
#
# ENVIRONMENTS:
#   local    → .env.local (this file as a template)
#   preview  → Vercel project dashboard env vars
#   production → Vercel project dashboard env vars
#
# PER-APP OVERRIDES:
#   App-specific .env.local files take precedence over root-level ones.
#   See apps/admin/.env.example, apps/marketing/.env.example, apps/mobile/.env.example.
# =============================================================================


# -----------------------------------------------------------------------------
# CONVEX
# Identifies the backend Convex deployment.
# Find this in the Convex dashboard under your project settings.
# Example: "dev:my-project-name-1a2b3c4d"
# -----------------------------------------------------------------------------
CONVEX_DEPLOYMENT=


# -----------------------------------------------------------------------------
# CLERK
# Authentication provider. The secret key is backend-only.
# The publishable key is safe to expose to clients (but listed here for
# reference — apps use VITE_CLERK_PUBLISHABLE_KEY or EXPO_PUBLIC_ variants).
# Find these in the Clerk dashboard under API Keys.
# -----------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_


# -----------------------------------------------------------------------------
# STRIPE
# Payment processing. Secret keys are backend-only.
# STRIPE_SECRET_KEY: Found in Stripe dashboard > Developers > API keys.
# STRIPE_PUBLISHABLE_KEY: Also in API keys (safe to expose but kept here for
#   server-side reference; apps use their own prefixed versions if needed).
# STRIPE_WEBHOOK_SECRET: Generated when creating a webhook endpoint in Stripe
#   dashboard > Developers > Webhooks. Starts with "whsec_".
# STRIPE_CONNECT_CLIENT_ID: Found in Stripe dashboard > Connect settings.
#   Starts with "ca_".
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_CONNECT_CLIENT_ID=ca_
STRIPE_CUSTOMER_PORTAL_URL=


# -----------------------------------------------------------------------------
# RESEND
# Transactional email. Backend-only.
# Find in the Resend dashboard under API Keys.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_


# -----------------------------------------------------------------------------
# APP URLS
# Base URLs for each app surface. Used to construct links in emails,
# webhooks, and cross-app redirects.
# local example values shown below.
# -----------------------------------------------------------------------------
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
