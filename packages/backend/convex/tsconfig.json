{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2021"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@repo/types": ["../../types/src"],
      "@repo/utils": ["../../utils/src"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": ["./_generated"]
}
